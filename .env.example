# Copy to .env.local for local development. Set the same names in Vercel → Settings → Environment Variables.
# Never commit real values.

# --- Clerk (dashboard.clerk.com → your app → API keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Stripe (dashboard.stripe.com) ---
# A restricted key is enough: the app only verifies webhooks with it.
STRIPE_SECRET_KEY=rk_live_xxx
# From the webhook endpoint you create for https://YOUR-DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional but recommended: only purchases through this Payment Link grant access (plink_...)
STRIPE_PAYMENT_LINK_ID=plink_xxx

# --- Site ---
# Public address of this site, no trailing slash (used in invitation emails)
APP_URL=https://playbook.eaacademy.online
# Where "Get the playbook" buttons go (your Stripe Payment Link URL)
NEXT_PUBLIC_BUY_URL=https://buy.stripe.com/xxx
